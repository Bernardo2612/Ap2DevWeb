<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cine_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="O que você curte?"
            android:textColor="@color/cine_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Passo 2 de 2 — marque um ou mais gêneros"
            android:textColor="@color/cine_muted" />

        <CheckBox
            android:id="@+id/cbAcao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ação" />

        <CheckBox
            android:id="@+id/cbComedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comédia" />

        <CheckBox
            android:id="@+id/cbDrama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Drama" />

        <CheckBox
            android:id="@+id/cbFiccao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ficção Científica" />

        <CheckBox
            android:id="@+id/cbTerror"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Terror" />

        <CheckBox
            android:id="@+id/cbRomance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Romance" />

        <CheckBox
            android:id="@+id/cbAnimacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Animação" />

        <CheckBox
            android:id="@+id/cbSuspense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Suspense" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Quanto tempo você tem?"
            android:textColor="@color/cine_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spDuracao"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp" />

        <ProgressBar
            android:id="@+id/pbCarregando"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDescobrir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/cine_primary"
            android:text="Descobrir meu filme"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>